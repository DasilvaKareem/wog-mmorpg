PORT=3000
WOG_SHARD_URL=http://127.0.0.1:3000

# Select one preset: local | testnet | mainnet
SHARD_CHAIN_ENV=testnet

# Local-only convenience switch. When DEV=true and SHARD_CHAIN_ENV=local,
# shard prefers the active Hardhat deployment manifest.
DEV=false

JWT_SECRET=replace-me
ENCRYPTION_KEY=replace-me
SERVER_PRIVATE_KEY=0x...
THIRDWEB_SECRET_KEY=
REDIS_URL=redis://127.0.0.1:6379/15

# Optional overrides. Leave blank to use the selected preset values.
SKALE_BASE_RPC_URL=
SKALE_BASE_CHAIN_ID=
GOLD_CONTRACT_ADDRESS=
ITEMS_CONTRACT_ADDRESS=
CHARACTER_CONTRACT_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
VALIDATION_REGISTRY_ADDRESS=
AUCTION_HOUSE_CONTRACT_ADDRESS=
TRADE_CONTRACT_ADDRESS=
GUILD_CONTRACT_ADDRESS=
GUILD_VAULT_CONTRACT_ADDRESS=
LAND_REGISTRY_CONTRACT_ADDRESS=
NAME_SERVICE_CONTRACT_ADDRESS=
PREDICTION_CONTRACT_ADDRESS=

# ── MPP / Tempo Direct-Buy Marketplace ────────────────────────────────
MPP_SECRET_KEY=
MPP_RECIPIENT_ADDRESS=0x...
MPP_CURRENCY_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
MPP_TESTNET=true

# ── NPC Dialogue Provider (Gemini) ───────────────────────────────────
# Uses the shared geminiClient: Vertex AI when GOOGLE_CLOUD_PROJECT is set,
# else GEMINI_API_KEY. LLM call is skipped if neither is configured
# (deterministic fallback only).
NPC_DIALOGUE_MODEL=gemini-2.5-flash-lite
NPC_DIALOGUE_TEMPERATURE=0.6
NPC_DIALOGUE_TIMEOUT_MS=12000

# ── NFT Bridge (SKALE Base ↔ Coinbase Base) ──────────────────────────
# Set to true to enable bridge HTTP routes + event listener.
# When false the routes return 503 and the listener does not start.
BRIDGE_ENABLED=false

# Both addresses are emitted by hardhat/scripts/deployCharacterBase.ts and
# deployBridgeAdapter.ts. They MUST be deployed before BRIDGE_ENABLED=true.
BASE_MAINNET_CHARACTER_CONTRACT=
SKALE_BRIDGE_ADAPTER_CONTRACT=

# Coinbase Base RPC. Defaults to the public endpoint; use a paid provider
# for production reliability.
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Claim TTL — how long a signed claim is valid for redemption.
BRIDGE_CLAIM_TTL_SECONDS=3600

# Rate limits.
BRIDGE_RATE_LIMIT_PER_HOUR=10
BRIDGE_RATE_LIMIT_GLOBAL_PER_HOUR=100

# Listener tuning. Defaults are sane; override only for testnet or low-RPC quota.
BRIDGE_LISTENER_POLL_MS=5000
BRIDGE_LISTENER_CONFIRMATIONS=1
BRIDGE_LISTENER_MAX_BLOCKS=2000
BRIDGE_REFUND_WORKER_POLL_MS=300000

# ── Circle / Nanopayments ────────────────────────────────────────────
# SNS Topic ARN that Circle publishes wallet-transfer notifications to.
# /webhooks/circle rejects (401) any SNS envelope whose TopicArn does not
# match this value. Leave unset to disable the webhook (returns 503).
CIRCLE_SNS_TOPIC_ARN=
CIRCLE_API_KEY=
CIRCLE_API_BASE=https://api.circle.com
CIRCLE_SELLER_WALLET_ID=
CIRCLE_SELLER_ADDRESS=
CIRCLE_GATEWAY_WALLET_CONTRACT=
